# Copia este archivo a .env y sustituye los valores. No subas nunca .env.

# Secreto interno de Garage: 64 caracteres hexadecimales (openssl rand -hex 32).
GARAGE_RPC_SECRET=sustituir-por-64-caracteres-hexadecimales

# Bucket y credenciales S3 de la app.
# S3_ACCESS_KEY_ID: "GK" seguido de 24 caracteres hexadecimales.
# S3_SECRET_ACCESS_KEY: 64 caracteres hexadecimales (openssl rand -hex 32).
S3_BUCKET=hanger-imagenes
S3_ACCESS_KEY_ID=sustituir-por-GK-y-24-hexadecimales
S3_SECRET_ACCESS_KEY=sustituir-por-64-caracteres-hexadecimales
